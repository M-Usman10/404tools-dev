# Copy to .env.local and fill in. This file is committed, so it must never
# contain a real key.

# Supabase Dashboard -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Dashboard -> Project Settings -> API Keys -> publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Supabase Dashboard -> Project Settings -> API Keys -> secret key (sb_secret_...).
# Bypasses RLS, so it must never be exposed to the browser. Required by the OCR
# route and the Paddle webhook, which have no cookie session to authorize with.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Origin the app is served from. Used to build Supabase auth callback URLs and
# the Paddle checkout return URL, so it must match the browser's address bar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Azure Portal -> your Document Intelligence resource -> Keys and Endpoint
AZURE_DOCINTEL_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCINTEL_KEY=your-azure-document-intelligence-key
# Azure Document Intelligence REST API version. 2024-11-30 is the current GA release.
AZURE_DOCINTEL_API_VERSION=2024-11-30

# "sandbox" while testing, "production" once the Paddle account is approved.
PADDLE_ENVIRONMENT=sandbox
# Paddle Dashboard -> Developer Tools -> Authentication -> API keys
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxxxxxxxxxxxxxxxxxx
# Paddle Dashboard -> Developer Tools -> Notifications -> your webhook destination -> secret key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxxxxxxxxx
# Paddle Dashboard -> Developer Tools -> Authentication -> Client-side tokens
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxx
# Must match PADDLE_ENVIRONMENT; Paddle.js picks its host from this.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Paddle Dashboard -> Catalog -> Products -> the page pack's one-time price ID
# (pri_...). One per pack in lib/page-packs.ts. These are one-time prices, not
# subscription plans.
PADDLE_PAGES_PRICE_ID_STARTER=pri_xxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_PAGES_PRICE_ID_GROWTH=pri_xxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_PAGES_PRICE_ID_SCALE=pri_xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Dashboard -> Turnstile -> your widget. Optional: leave both blank
# and the signup/login forms simply skip the challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
